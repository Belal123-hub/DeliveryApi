  "components": {
    "schemas": {
      "AddDishToBasketDto": {
        "type": "object",
        "properties": {
          "dishId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "DishBasketDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "totalPrice": {
            "type": "number",
            "format": "double"
          },
          "amount": {
            "type": "integer",
            "format": "int32"
          },
          "image": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DishCategory": {
        "enum": [
          "Wok",
          "Pizza",
          "Soup",
          "Dessert",
          "Drink"
        ],
        "type": "string"
      },
      "DishSorting": {
        "enum": [
          "NameAsc",
          "NameDesc",
          "PriceAsc",
          "PriceDesc",
          "RatingAsc",
          "RatingDesc"
        ],
        "type": "string"
      },
      "LoginCredentialsDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrderCreateDto": {
        "required": [
          "address",
          "deliveryTime"
        ],
        "type": "object",
        "properties": {
          "deliveryTime": {
            "type": "string",
            "format": "date-time"
          },
          "address": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OrderDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "deliveryTime": {
            "type": "string",
            "nullable": true
          },
          "orderTime": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "enum": [
              "Pending",
              "Delivered"
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/OrderStatus"
              }
            ]
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "dishes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DishBasketDto"
            },
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrderInfoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deliveryTime": {
            "type": "string",
            "format": "date-time"
          },
          "orderTime": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "Pending",
              "Delivered"
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/OrderStatus"
              }
            ]
          },
          "price": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "OrderStatus": {
        "enum": [
          "Pending",
          "Delivered"
        ],
        "type": "string"
      },
      "RefreshCredentialsDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Response": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserCreateDto": {
        "required": [
          "email",
          "name",
          "password"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "UserEditModelDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Bearer Authentication with JWT Token",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
